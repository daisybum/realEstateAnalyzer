# ===========================================
# Real Estate Analyzer - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ------------------------------------------
# LangSmith Configuration (Optional)
# ------------------------------------------
# Get your API key from: https://smith.langchain.com/settings
LANGSMITH_API_KEY=ls-your-api-key-here

# Enable tracing for debugging and monitoring
LANGSMITH_TRACING=true

# Project name for organizing traces
LANGSMITH_PROJECT=realEstateAnalyzer

# API endpoint (default: https://api.smith.langchain.com)
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ------------------------------------------
# HuggingFace Configuration (Optional)
# ------------------------------------------
# Required for gated models (e.g., Llama, Qwen-gated)
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=hf-your-token-here

# ------------------------------------------
# vLLM API Configuration
# ------------------------------------------
# Local vLLM server URL
VLLM_API_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY

# ------------------------------------------
# Analysis Configuration
# ------------------------------------------
# Environment: dev / staging / prod
PROMPT_ENVIRONMENT=prod
