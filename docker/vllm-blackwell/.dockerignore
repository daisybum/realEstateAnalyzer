# Docker ignore patterns for vLLM Blackwell build
# Reduces build context size and speeds up builds

# Git files
.git/
.gitignore
.gitattributes

# Documentation
README.md
*.md

# Environment files
.env
.env.*
!.env.example

# Build artifacts
build/
dist/
*.egg-info/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# Model files (should be downloaded at runtime or mounted)
models/
*.safetensors
*.bin
*.pt
*.pth

# Cache directories
.cache/
.triton_cache/

# Test files
tests/
test_*.py
*_test.py

# Scripts not needed in container
build_and_run.sh
update_cuda_env.sh
